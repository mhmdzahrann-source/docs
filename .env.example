# Instagram Graph API credentials.
# See README.md "Instagram API Setup" for a full walkthrough of how to obtain these.

# Long-lived User Access Token generated via Graph API Explorer (expires after 60 days).
INSTAGRAM_ACCESS_TOKEN=

# The Instagram Business/Creator account ID linked to your Facebook Page.
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Facebook App Secret, used to verify the X-Hub-Signature-256 header on incoming webhooks.
FACEBOOK_APP_SECRET=

# Arbitrary string you choose. Facebook echoes this back during the webhook
# verification handshake (GET /webhook/instagram) to prove you own the endpoint.
WEBHOOK_VERIFY_TOKEN=

# SQLAlchemy database URL. Defaults to a local SQLite file; swap for a
# Postgres URL (e.g. postgresql://user:pass@host:5432/dbname) in production.
DATABASE_URL=sqlite:///./app.db

# ---------- WhatsApp reservation bot ----------
# See README.md "WhatsApp reservation bot" for how to get these.
# Like the Instagram values, they only seed the database on first boot;
# after that the dashboard Settings page is authoritative.

# Permanent System User token with whatsapp_business_messaging permission.
WHATSAPP_ACCESS_TOKEN=

# Meta-assigned ID of your business number (NOT the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=

# Name the bot greets customers with.
BUSINESS_NAME=Khayal

# Your own WhatsApp number in international format, for new-booking alerts.
OWNER_WHATSAPP_NUMBER=

# Timezone used for "today"/"tomorrow" and past-time checks (IANA name).
BUSINESS_TIMEZONE=Asia/Riyadh
