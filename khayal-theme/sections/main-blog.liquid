{%- paginate blog.articles by 12 -%}
<section class="wrap page">
  <h1 class="page-title">{{ blog.title | escape }}</h1>
  <div class="pf" style="grid-template-columns:repeat(auto-fill,minmax(280px,1fr))">
    {%- for article in blog.articles -%}
      <a href="{{ article.url }}" class="pcard">
        <div class="pcard-media" style="aspect-ratio:4/3">{%- if article.image -%}{{ article.image | image_url: width: 900 | image_tag: alt: article.title, loading: 'lazy' }}{%- else -%}{{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}</div>
        <div class="pcard-title" style="font-size:20px">{{ article.title | escape }}</div>
        <div class="pcard-price">{{ article.published_at | time_tag: format: 'date' }}</div>
      </a>
    {%- endfor -%}
  </div>
  {% render 'pagination', paginate: paginate %}
</section>
{%- endpaginate -%}
{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
