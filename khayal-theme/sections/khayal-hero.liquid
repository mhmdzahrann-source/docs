<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      {%- if section.settings.live_text != blank -%}<span class="live w d1"><span class="dot"></span>{{ section.settings.live_text | escape }}</span>{%- endif -%}
      <h1 class="h1"><span class="w d2">{{ section.settings.line1a | escape }}</span> <span class="w d3">{{ section.settings.line1b | escape }}</span><br><span class="w d4">{{ section.settings.line2a | escape }}</span> <span class="w d5 serif">{{ section.settings.line2b | escape }}</span></h1>
      {%- if section.settings.lead != blank -%}<p class="lead w d6">{{ section.settings.lead | escape }}</p>{%- endif -%}
      <div class="cta-row w d7">
        {%- if section.settings.btn1_label != blank -%}<a href="{{ section.settings.btn1_link | default: routes.all_products_collection_url }}" class="btn btn-light">{{ section.settings.btn1_label | escape }}</a>{%- endif -%}
        {%- if section.settings.btn2_label != blank -%}<a href="{{ section.settings.btn2_link | default: '/collections/khayal-rides' }}" class="btn btn-ghost-n">{{ section.settings.btn2_label | escape }}</a>{%- endif -%}
      </div>
    </div>
    <div class="hero-media">
      <div class="hero-img">{% render 'k-image', image: section.settings.image, fallback: 'khayal-hero.jpg', alt: section.settings.image_alt, sizes: '(max-width: 960px) 100vw, 50vw', loading: 'eager' %}</div>
      {%- if section.settings.float_title != blank -%}
      <a class="float-a" href="{{ section.settings.float_link | default: '/collections/khayal-rides' }}">
        {% render 'k-image', image: section.settings.float_image, fallback: 'khayal-ride.jpg', alt: '' %}
        <div><div style="font-size:14px;font-weight:600">{{ section.settings.float_title | escape }}</div><div style="font-size:12px;color:var(--on-night-2)">{{ section.settings.float_sub | escape }}</div></div>
      </a>
      {%- endif -%}
      {%- if section.settings.badge_number != blank -%}
      <div class="float-b"><strong>{{ section.settings.badge_number | escape }}</strong><span>{{ section.settings.badge_label | escape }}</span></div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Khayal hero",
  "settings": [
    { "type": "text", "id": "live_text", "label": "Small top line", "default": "Rides near the Giza Pyramids · Cairo" },
    { "type": "text", "id": "line1a", "label": "Headline word 1", "default": "Gear" },
    { "type": "text", "id": "line1b", "label": "Headline word 2", "default": "up." },
    { "type": "text", "id": "line2a", "label": "Headline word 3", "default": "Ride" },
    { "type": "text", "id": "line2b", "label": "Headline word 4 (gold italic)", "default": "beyond." },
    { "type": "textarea", "id": "lead", "label": "Intro text", "default": "Premium horse supplies, riding gear and stable equipment, plus guided rides and training at the Giza Pyramids." },
    { "type": "text", "id": "btn1_label", "label": "Button 1 label", "default": "Shop the collection →" },
    { "type": "url", "id": "btn1_link", "label": "Button 1 link", "info": "Empty = all products." },
    { "type": "text", "id": "btn2_label", "label": "Button 2 label", "default": "Book a ride" },
    { "type": "url", "id": "btn2_link", "label": "Button 2 link", "info": "Empty = Khayal Rides collection." },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Empty = bundled Khayal photo." },
    { "type": "text", "id": "image_alt", "label": "Image description", "default": "Bay horse wearing a navy and leather Khayal halter in the stable" },
    { "type": "header", "content": "Floating card" },
    { "type": "image_picker", "id": "float_image", "label": "Card image" },
    { "type": "text", "id": "float_title", "label": "Card title", "default": "Pyramids Ride", "info": "Empty = hide the card." },
    { "type": "text", "id": "float_sub", "label": "Card text", "default": "Sunrise · Sunset slots" },
    { "type": "url", "id": "float_link", "label": "Card link" },
    { "type": "header", "content": "Number badge" },
    { "type": "text", "id": "badge_number", "label": "Number", "default": "60K+", "info": "Empty = hide the badge." },
    { "type": "text", "id": "badge_label", "label": "Label", "default": "riders on the Khayal app" }
  ],
  "presets": [{ "name": "Khayal hero" }]
}
{% endschema %}
