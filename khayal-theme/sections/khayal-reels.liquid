{%- capture reels -%}
  {%- for block in section.blocks -%}
    <a href="{{ block.settings.link | default: settings.social_instagram }}" class="reel" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
      {% render 'k-image', image: block.settings.image, fallback: block.settings.fallback, alt: block.settings.caption, sizes: '260px' %}
      <span class="play"><svg width="14" height="14" viewBox="0 0 24 24" fill="#0E1510" aria-hidden="true"><path d="M7 5l12 7-12 7z"/></svg></span>
      {%- if block.settings.caption != blank -%}<span class="reel-cap">{{ block.settings.caption | escape }}</span>{%- endif -%}
    </a>
  {%- endfor -%}
{%- endcapture -%}
<section id="stories" style="padding-block:104px 88px">
  <div class="wrap sec-head reveal">
    <h2 class="h2">{{ section.settings.heading | escape }}<span class="serif">{{ section.settings.heading_accent | escape }}</span></h2>
    {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" class="btn btn-ghost-s" target="_blank" rel="noopener">{{ section.settings.button_label | escape }}</a>{%- endif -%}
  </div>
  <div class="reels marq" style="overflow:hidden">
    <div class="track">{{ reels }}<span style="display:contents" aria-hidden="true">{{ reels | replace: 'class="reel"', 'class="reel" tabindex="-1" aria-hidden="true"' }}</span></div>
  </div>
</section>

{% schema %}
{
  "name": "Khayal Instagram reels",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "#Ride" },
    { "type": "text", "id": "heading_accent", "label": "Heading (italic part)", "default": "Khayal" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Follow on Instagram →" }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Reel",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Cover image" },
        { "type": "text", "id": "fallback", "label": "Bundled photo (advanced)" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "Pyramids Ride" },
        { "type": "url", "id": "link", "label": "Instagram post link", "info": "Empty = your Instagram profile." }
      ]
    }
  ],
  "presets": [{ "name": "Khayal Instagram reels", "blocks": [{ "type": "reel" }] }]
}
{% endschema %}
