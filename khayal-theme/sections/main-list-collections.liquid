<section class="wrap page">
  <h1 class="page-title">{{ 'collections.all_title' | t }}</h1>
  <div class="bento">
    {%- for c in collections -%}
      {%- if c.handle == 'all' or c.products_count == 0 -%}{%- continue -%}{%- endif -%}
      <a href="{{ c.url }}" class="tile">
        {%- if c.featured_image -%}{{ c.featured_image | image_url: width: 900 | image_tag: alt: c.title, loading: 'lazy' }}{%- else -%}{{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
        <div class="t-label">{{ c.title | escape }}<span class="arrow">→</span></div>
      </a>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{ "name": "Collections list", "settings": [] }
{% endschema %}
