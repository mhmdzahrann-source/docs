<section class="wrap page">
  <h1 class="page-title">{{ page.title | escape }}</h1>
  {%- if page.content != blank -%}<div class="rte" style="margin-bottom:32px">{{ page.content }}</div>{%- endif -%}
  {%- form 'contact', class: 'form-card', style: 'margin:0' -%}
    {%- if form.posted_successfully? -%}<p class="form-msg">{{ 'contact.success' | t }}</p>{%- endif -%}
    {%- if form.errors -%}<div class="errors">{{ form.errors | default_errors }}</div>{%- endif -%}
    <label for="ContactName">{{ 'contact.name' | t }}</label>
    <input class="field" id="ContactName" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}">
    <label for="ContactEmail">{{ 'contact.email' | t }} *</label>
    <input class="field" id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}">
    <label for="ContactPhone">{{ 'contact.phone' | t }}</label>
    <input class="field" id="ContactPhone" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}">
    <label for="ContactBody">{{ 'contact.message' | t }}</label>
    <textarea class="field" id="ContactBody" name="contact[body]">{{ form.body }}</textarea>
    <button type="submit" class="btn btn-dark">{{ 'contact.send' | t }}</button>
  {%- endform -%}
</section>
{% schema %}
{ "name": "Contact form", "settings": [] }
{% endschema %}
