<section id="shop" class="wrap" style="padding-block:88px 104px">
  <div class="sec-head reveal">
    <h2 class="h2">{{ section.settings.heading | escape }} <span class="serif">{{ section.settings.heading_accent | escape }}</span></h2>
    <a href="{{ section.settings.all_link | default: routes.all_products_collection_url }}" class="btn btn-ghost-s">{{ section.settings.all_label | escape }}</a>
  </div>
  <div class="bento">
    {%- for block in section.blocks -%}
      {%- if block.type != 'tile' -%}{%- continue -%}{%- endif -%}
      {%- liquid
        assign c = block.settings.collection
        assign href = block.settings.link | default: c.url | default: routes.all_products_collection_url
        assign title = block.settings.title | default: c.title
        assign img = block.settings.image | default: c.featured_image
      -%}
      <a href="{{ href }}" class="tile{% if block.settings.size == 'big' %} t-big{% elsif block.settings.size == 'wide' %} t-wide{% endif %} reveal" {{ block.shopify_attributes }}>
        {% render 'k-image', image: img, fallback: block.settings.fallback, alt: title, sizes: '(max-width: 960px) 100vw, 50vw' %}
        {%- if block.settings.size == 'normal' -%}
          <div class="t-label">{{ title | escape }}<span class="arrow">→</span></div>
        {%- else -%}
          <div class="t-over"{% if block.settings.size == 'wide' %} style="background:linear-gradient(90deg,rgba(14,21,16,.8),transparent 75%);inset:0;align-items:flex-end"{% endif %}><div>{% if block.settings.subtitle != blank %}<div class="t-sub">{{ block.settings.subtitle | escape }}</div>{% endif %}<div class="t-name">{{ title | escape }}</div></div><span class="arrow">→</span></div>
        {%- endif -%}
      </a>
    {%- endfor -%}
  </div>
  <div class="chips reveal">
    {%- for block in section.blocks -%}
      {%- if block.type == 'chip' -%}
        <a href="{{ block.settings.link | default: block.settings.collection.url | default: routes.all_products_collection_url }}" class="chip" {{ block.shopify_attributes }}>{{ block.settings.title | default: block.settings.collection.title | escape }}</a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Khayal tack room",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The tack" },
    { "type": "text", "id": "heading_accent", "label": "Heading (italic part)", "default": "room." },
    { "type": "text", "id": "all_label", "label": "Button label", "default": "All products →" },
    { "type": "url", "id": "all_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection", "info": "Pick the collection this tile opens." },
        { "type": "url", "id": "link", "label": "Custom link (optional)" },
        { "type": "text", "id": "title", "label": "Title", "info": "Empty = collection name." },
        { "type": "text", "id": "subtitle", "label": "Small text (big and wide tiles)" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "select", "id": "size", "label": "Size", "default": "normal", "options": [ { "value": "normal", "label": "Normal" }, { "value": "big", "label": "Big" }, { "value": "wide", "label": "Wide" } ] },
        { "type": "text", "id": "fallback", "label": "Bundled photo (advanced)", "info": "Used only when no image or collection image is set." }
      ]
    },
    {
      "type": "chip",
      "name": "Category chip",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "url", "id": "link", "label": "Custom link (optional)" },
        { "type": "text", "id": "title", "label": "Label" }
      ]
    }
  ],
  "presets": [{ "name": "Khayal tack room" }]
}
{% endschema %}
