<section class="wrap page" style="min-height:100vh;display:flex;flex-direction:column;justify-content:center;gap:28px">
  <div class="logo" style="font-size:40px">{{ shop.name | downcase }}<b>.</b></div>
  <h1 class="h1">Gear up. <span class="serif">Soon.</span></h1>
  {%- if shop.password_message != blank -%}<p class="lead">{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'storefront_password', style: 'display:flex;gap:8px;max-width:480px' -%}
    {%- if form.errors -%}<div class="errors">{{ form.errors | default_errors }}</div>{%- endif -%}
    <label class="visually-hidden" for="StorePassword">Password</label>
    <input class="field" type="password" name="password" id="StorePassword" placeholder="Password">
    <button class="btn btn-brass" type="submit">Enter</button>
  {%- endform -%}
</section>
