{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ shop.name }} gift card</title>
  {{ 'khayal.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>
  <main class="wrap page" style="text-align:center;display:flex;flex-direction:column;gap:20px;align-items:center">
    <div class="logo" style="font-size:32px">{{ shop.name | downcase }}<b>.</b></div>
    <h1 class="page-title">{{ gift_card.balance | money }}</h1>
    {%- if gift_card.expired -%}<p class="muted">Expired on {{ gift_card.expires_on | date: '%B %e, %Y' }}</p>{%- endif -%}
    <p style="font-size:24px;font-weight:600;letter-spacing:.08em">{{ gift_card.code | format_code }}</p>
    {%- if gift_card.pass_url -%}<a href="{{ gift_card.pass_url }}"><img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="Add to Apple Wallet" loading="lazy"></a>{%- endif -%}
    <a href="{{ shop.url }}" class="btn btn-dark">Shop now</a>
    <button class="btn btn-ghost-s" onclick="window.print()">Print</button>
  </main>
</body>
</html>
