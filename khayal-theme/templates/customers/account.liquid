<section class="wrap page">
  <h1 class="page-title">{{ 'customer.account' | t }}</h1>
  <p><a href="{{ routes.account_logout_url }}" class="btn btn-ghost-s">{{ 'customer.log_out' | t }}</a></p>
  <div class="cart-grid" style="margin-top:32px">
    <div>
      <h2 style="font-size:24px;margin-bottom:16px">{{ 'customer.orders' | t }}</h2>
      {%- paginate customer.orders by 20 -%}
      {%- if customer.orders.size > 0 -%}
        <table class="table">
          <thead><tr><th>{{ 'customer.order' | t }}</th><th>{{ 'customer.date' | t }}</th><th>{{ 'customer.status' | t }}</th><th>{{ 'customer.total' | t }}</th></tr></thead>
          <tbody>
          {%- for order in customer.orders -%}
            <tr><td><a href="{{ order.customer_url }}" style="text-decoration:underline">{{ order.name }}</a></td><td>{{ order.created_at | time_tag: format: 'date' }}</td><td>{{ order.fulfillment_status_label }}</td><td>{{ order.total_net_amount | money_with_currency }}</td></tr>
          {%- endfor -%}
          </tbody>
        </table>
      {%- else -%}<p class="muted">{{ 'customer.no_orders' | t }}</p>{%- endif -%}
      {% render 'pagination', paginate: paginate %}
      {%- endpaginate -%}
    </div>
    <aside class="cart-sum">
      <h2 style="font-size:20px">{{ 'customer.details' | t }}</h2>
      {{ customer.default_address | format_address }}
      <a href="{{ routes.account_addresses_url }}" class="btn btn-ghost-s">{{ 'customer.addresses' | t }} ({{ customer.addresses_count }})</a>
    </aside>
  </div>
</section>
