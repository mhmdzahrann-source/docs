<section class="wrap page">
  {%- form 'reset_customer_password', class: 'form-card' -%}
    <h1 class="page-title" style="margin:0">{{ 'customer.reset' | t }}</h1>
    {%- if form.errors -%}<div class="errors">{{ form.errors | default_errors }}</div>{%- endif -%}
    <label for="ResetPass">{{ 'customer.password' | t }}</label><input class="field" type="password" name="customer[password]" id="ResetPass" autocomplete="new-password">
    <label for="ResetPass2">{{ 'customer.password_confirm' | t }}</label><input class="field" type="password" name="customer[password_confirmation]" id="ResetPass2" autocomplete="new-password">
    <button class="btn btn-dark" type="submit">{{ 'customer.reset' | t }}</button>
  {%- endform -%}
</section>
